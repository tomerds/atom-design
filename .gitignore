# macOS
.DS_Store

# Personal Claude Code settings (shared settings live in .claude/settings.json)
.claude/settings.local.json

# Ignore all top-level directories (project deliverables stay local)
# except the shared brand assets and Claude Code setup.
/*/
!/assets/
!/.claude/

# Exception: the finalized intro-call-deck template + its assets are shared
# (the intro-call-deck skill points at them), so track those specifically.
# One-off per-prospect decks stay local.
!/Intro_Call_Deck/
/Intro_Call_Deck/*
!/Intro_Call_Deck/Intro_Call_Deck.html
!/Intro_Call_Deck/img/

# Same for the renewal upsell-deck template (the upsell-deck skill points at it).
# Per-partner decks + the git-ignored tempimg/ logo stay local.
!/Upsell_Deck/
/Upsell_Deck/*
!/Upsell_Deck/Upsell_Deck.html
!/Upsell_Deck/img/

# Same for the onboarding kickoff-deck template (the kickoff-deck skill points at it).
# Per-partner decks (<Slug>_Kickoff/, incl. the partner logo) stay local.
!/Kickoff_Deck/
/Kickoff_Deck/*
!/Kickoff_Deck/Kickoff_Deck.html

# Same for the webinar-deck template (the webinar-deck skill points at it).
# Speaker headshots come from the local, git-ignored Webinar_Tiles/.
!/Webinar_Deck/
/Webinar_Deck/*
!/Webinar_Deck/Webinar_Deck.html
!/Webinar_Deck/webinars_qr.png

# The checkin-deck skill's reference component library lives inside the skill
# at .claude/skills/checkin-deck/references/ (tracked via the !/.claude/ rule
# above). Built partner check-in decks are deliverables and stay local.

# Python bytecode
__pycache__/
*.pyc
